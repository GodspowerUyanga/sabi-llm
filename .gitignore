# Models (downloaded from Hugging Face, too large for Git)
*.gguf
models/*.bin
models/*.partial
models/sabi-yoruba-tts/
models/.hf_cache/

# Model build scratch (llama.cpp checkout + raw downloads + fp16 intermediates)
.llama.cpp/
.model-build/

# SABI runtime state
sabi_workspace/.sabi/
sabi_workspace/**/
!sabi_workspace/.gitkeep

# Per-project SABI memory (created inside whatever directory `sabi` is run
# from — analogous to .git — so it lives at the root of every project SABI
# is pointed at, not just this repo)
.sabi/

# Benchmarks output
benchmarks/report.json
benchmarks/report.md

# Leftovers from an earlier abandoned branch / local scratch — never part of
# this repo's tracked structure (old debtor/summary spreadsheet exports, an
# old RAG index, stale compliance/benchmark reports measured against the
# wrong model, and the local adtc-profiler output).
data/
model/
COMPLIANCE.md
benchmark_report.json
submission.json

